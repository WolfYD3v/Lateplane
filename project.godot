; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lateplane"
run/main_scene="uid://du02s2cxy4jtc"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false

[autoload]

SaveManager="uid://dcfaf2b2iggwh"
SceneManager="*uid://cuhdcmnfn0y1b"
SettingsManager="uid://wcsvrt73ybo8"
RunManager="*uid://dmgqomw8pev7j"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gitot/plugin.cfg", "res://addons/unibuilder/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
