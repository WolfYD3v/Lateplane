[node name="TutorialCard1" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="0" unique_id=2093123670 instance=ExtResource("6_r2trq")]
layout_mode = 1
card_title = "Les bases"
card_image = ExtResource("7_l60hg")
card_info = "Le jeu va choisir une ville aléatoire parmis celle disponibles . La ville en elle même va, à travers un système de génération aléatoire des Points un peu trop poussé pour l'expliquer, devenir aléatoire .
Même si le placement de tous les Points reste identique dans toutes les runs, la nature même des Points peut varier ."

[node name="TutorialCard2" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="1" unique_id=83138990 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "Les bases"
card_image = ExtResource("7_l60hg")
card_info = "Dans chaque niveau, tu dois traverser les villes dans un nombre de jours imparti .
Ton but est d'atteindre le seul est unique aéroport de la ville (un peu suspension d'incrédulité ne faiit pas de mal mr. je suis logique) dans ces x nombre de jours donnés .
Dans le cas où cet objectif n'a pas été réalisé, la run est perdue ."

[node name="TutorialCard3" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="2" unique_id=1858590122 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "Les Points"
card_image = ExtResource("8_cxq8o")
card_info = "Comme dit précédement, les Points définissent le parcours statique proposé par les villes .
Il existe plusieurs types de Points, dont le plus important : L'End Point . Il te permet de prendre un avion vers la prochaine ville (ou de finir le tutoriel dans ce cas) .
Quand un Point est entouré d'un cercle coloré, tu peux aller sur ce dernier . C'est comme ça que tu te déplaces dans la ville ."

[node name="TutorialCard4" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="3" unique_id=1526169572 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "Les Points"
card_image = ExtResource("9_26fse")
card_info = "Certains Points activeront des évènements, choisis au hasard . Bien que le MJ peut intervenir pour te faire tester ta chance, avec un jet ."

[node name="TutorialCard5" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="4" unique_id=1135519467 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "Les Shops"
card_image = ExtResource("10_axelv")
card_info = "Il existe un type de Points qui permet de rentrer dans une petite boutique locale . Celle-ci est choisie aléatoirement, et propose à la vente des Items qui peuvent changer comment se passe la Run .
Pour les acheter, tu auras besoin de sous . Heureusement que tu en gagnes à chaques fois que tu arrives sur un Point ! Quel heureux hasard putain ;)"

[node name="TutorialCard6" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="5" unique_id=405586601 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "L'inventaire"
card_image = ExtResource("11_7c7i4")
card_info = "Tes Items achetés arriveront dans ton Inventaire . Tu peux y accéder en cliquant en bas à droite de l'écran .
Pour utiliser un Item, c'est facile : Cliquer sur l'Item, depuis ton Inventaire ."

[node name="TutorialCard7" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="6" unique_id=989410142 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "Le journal"
card_image = ExtResource("12_rrqyi")
card_info = "Le MJ suit ton voyage de très près .
Il tient un journal de la globalité des évènements de ton voyage . Pourquoi ? Don't know . Mais il te le fait lire quand ta run est finie (en cas de victoire, comme de défaite)"

[node name="TutorialCard8" parent="CanvasLayer/TutorialSection/Control/MarginContainer/CardsContainer" index="7" unique_id=1327760264 instance=ExtResource("6_r2trq")]
visible = false
layout_mode = 1
card_title = "A toi de jouer now !"
card_image = ExtResource("13_kluk5")
card_info = "Tout a été dit .
gud luk !"

